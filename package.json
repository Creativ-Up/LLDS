{
  "name": "llds",
  "private": true,
  "type": "module",
  "description": "Les lignes du souvenir — monorepo (app mobile, back-office, Supabase).",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:tunnel": "pnpm --filter @llds/mobile dev:tunnel",
    "dev:usb": "tsx scripts/dev-usb.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "tokens": "pnpm --filter @llds/shared tokens",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "pnpm seed:build && supabase db reset && pnpm seed:upload",
    "db:types": "tsx scripts/gen-db-types.ts",
    "db:check": "tsx scripts/check-rls.ts",
    "db:check:onboarding": "tsx scripts/check-onboarding.ts",
    "seed:build": "tsx scripts/seed/build-seed.ts",
    "seed:upload": "tsx scripts/seed/upload-seed.ts",
    "env:local": "tsx scripts/write-local-env.ts",
    "bootstrap": "pnpm install && pnpm db:start && pnpm db:reset && pnpm env:local"
  },
  "devDependencies": {
    "@llds/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.15.0",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  }
}
